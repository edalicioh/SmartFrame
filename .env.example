# Execute npm run setup:env para criar .env com um segredo aleatório.
DATABASE_URL=file:./.data/smartframe.db
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
STORAGE_PATH=./.data/media
# Obrigatório no Docker. No acesso remoto, use uma URL HTTPS com certificado confiável.
SMARTFRAME_PORT=8080
# disabled remove o login somente no endereço local. Não publique esse modo na rede.
SMARTFRAME_ADMIN_LOGIN=required
# Opcional: obrigatório no modo sem login se houver várias contas no banco.
SMARTFRAME_ADMIN_EMAIL=
# Player online: habilitado somente para dispositivos deste household.
SMARTFRAME_ONLINE_HOUSEHOLD_ID=
# Caminhos no servidor; no Docker, use os padrões dentro do volume /app/.data.
SMARTFRAME_ONLINE_CONFIG=./.data/player-online/config.json
SMARTFRAME_ONLINE_PHOTOS=./.data/player-online/photos
